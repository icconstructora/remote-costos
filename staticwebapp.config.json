{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*"]
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "Access-Control-Allow-Origin": "https://vic.icconstructora.co"
      }
    },
    {
      "route": "/remoteEntry.js",
      "headers": {
        "Access-Control-Allow-Origin": "https://vic.icconstructora.co"
      }
    },
    {
      "route": "/data/*",
      "headers": {
        "Access-Control-Allow-Origin": "https://vic.icconstructora.co"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "Access-Control-Allow-Origin": "https://vic.icconstructora.co"
      }
    }
  ]
}
